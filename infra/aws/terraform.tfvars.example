aws_region  = "us-east-1"
name_prefix = "ai-project-management"
frontend_url = "https://your-frontend.example.com"
cors_origin  = "https://your-frontend.example.com"
app_domain   = "api.your-domain.example"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

runtime_secrets = {
  jwt_access_token_secret  = "replace-with-a-random-secret-at-least-32-chars"
  jwt_refresh_token_secret = "replace-with-a-different-random-secret-32-chars"
  cookie_secret            = "replace-with-another-random-secret-32-chars"
  glm_api_key              = ""
}

# Keep false for the initial infrastructure apply. Set true only after pushing
# the image and applying the database migration task.
deploy_services = false
